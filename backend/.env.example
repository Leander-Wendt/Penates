ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/penates?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=24h
CORS_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:5173
SEED_ADMIN_EMAIL=admin@penates.local
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
SEED_ADMIN_ORG=Default
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=1m
# run `make certs` from the repo root to create these
TLS_CERT_FILE=../certs/localhost.pem
TLS_KEY_FILE=../certs/localhost-key.pem

# SSO / OIDC Configuration (optional - disable by leaving SSO_ENABLED=false)
# Set SSO_ENABLED=true to enable Single Sign-On
SSO_ENABLED=false
# OIDC Provider discovery URL (e.g., https://authentik.example.com/application/o/penates/.well-known/openid-configuration)
SSO_PROVIDER_URL=
# OIDC Client credentials from your provider
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Backend callback URL (must match what's configured in your OIDC provider)
SSO_REDIRECT_URL=https://localhost:8080/api/v1/auth/oauth/callback
# Frontend URL to redirect to after successful authentication
SSO_FRONTEND_CALLBACK_URL=https://localhost:3000/login
# Requested OIDC scopes (comma-separated)
SSO_SCOPES=openid,email,profile
# Allowed email domains for SSO users (comma-separated, e.g., "bht-berlin.de,student.bht-berlin.de")
SSO_ALLOWED_DOMAINS=
# Default role for new SSO users (admin, logistics, or student)
SSO_DEFAULT_ROLE=student
