ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/penates?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=24h
CORS_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:5173
SEED_ADMIN_EMAIL=admin@penates.local
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
SEED_ADMIN_ORG=Default
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=1m
# run `make certs` from the repo root to create these
TLS_CERT_FILE=../certs/localhost.pem
TLS_KEY_FILE=../certs/localhost-key.pem
