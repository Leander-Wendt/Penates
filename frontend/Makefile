.PHONY: install dev build test test-watch lint format typecheck docker-build

install:
	npm ci

dev:
	npm run dev

build:
	npm run build

test:
	npm run test

test-watch:
	npm run test:watch

lint:
	npm run lint

format:
	npm run format

typecheck:
	npm run typecheck

docker-build:
	docker build -t penates-frontend .
